+// MIP token channel: a sampler at the head of the chain that streams every accepted token to the MIP service and applies the plans it
+// returns (mip-research docs/plans/2026-11-12-mip-token-channel-design.md). Off unless the request carries a `mip_id` and the server's
+// environment names the service (MIP_CHANNEL=host:port). MIP_CHANNEL_MS (default 50): the longest wait for a plan at a sample.
+#pragma once
+
+#include "llama.h"
+
+#include <string>
+
+// a new shim for one request, or nullptr when MIP_CHANNEL is unset or mip_id is empty
+struct llama_sampler * mip_channel_init(const std::string & mip_id);
